{
  "name": "mdr-intelligence",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "next dev",
    "next:dev": "next dev",
    "legacy:dev": "concurrently \"npm run legacy:server\" \"npm run legacy:client\"",
    "legacy:server": "node server/index.js",
    "legacy:client": "cd client && npm run dev",
    "build": "next build",
    "start": "next start",
    "worker": "npx tsx src/workers/start.ts",
    "worker:dev": "npx tsx watch src/workers/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@prisma/client": "^5.16.0",
    "better-sqlite3": "^9.4.3",
    "bullmq": "^5.8.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dxf-writer": "^1.6.0",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.35",
    "next-auth": "^4.24.14",
    "pdf2pic": "^3.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "sharp": "^0.33.4",
    "stripe": "^22.2.1",
    "three": "^0.166.1",
    "three-stdlib": "^2.29.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.166.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prisma": "^5.16.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
