{
  "name": "mdr-intelligence",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "worker": "npx tsx --tsconfig tsconfig.json src/workers/start.ts",
    "worker:dev": "npx tsx watch --tsconfig tsconfig.json src/workers/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@prisma/client": "^5.16.0",
    "better-sqlite3": "^9.4.3",
    "bullmq": "^5.8.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dxf-writer": "^1.6.0",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "pdf2pic": "^3.1.3",
    "sharp": "^0.33.4",
    "three": "^0.166.1",
    "three-stdlib": "^2.29.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.166.0",
    "prisma": "^5.16.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
